{
  "realm": "rucio",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "sslRequired": "none",

  "groups": [
    {
      "name": "rucio",
      "path": "/rucio",
      "subGroups": [
        { "name": "admins", "path": "/rucio/admins" },
        { "name": "users",  "path": "/rucio/users" }
      ]
    },
    {
      "name": "atlas",
      "path": "/atlas",
      "subGroups": [
        { "name": "production", "path": "/atlas/production" },
        { "name": "users",      "path": "/atlas/users" }
      ]
    }
  ],

  "users": [
    {
      "username": "alice",
      "email": "alice@example.org",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice123", "temporary": false }],
      "groups": ["/rucio/users", "/atlas/users"],
      "attributes": {
        "entitlements": [
          "urn:example:aai.example.org:group:rucio-users:role=member",
          "urn:example:aai.example.org:group:atlas-users:role=member"
        ]
      }
    },
    {
      "username": "adminuser",
      "email": "admin@example.org",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "groups": ["/rucio/admins", "/atlas/production"],
      "attributes": {
        "entitlements": [
          "urn:example:aai.example.org:group:rucio-admins:role=member",
          "urn:example:aai.example.org:group:atlas-production:role=member"
        ]
      }
    }
  ],

  "clients": [
    {
      "clientId": "rucio-oidc",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "rucio-oidc-secret",
      "publicClient": false,
      "redirectUris": ["http://rucio/*", "http://localhost/*"],
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["openid", "profile", "email", "entitlements"]
    }
  ],

  "clientScopes": [
    {
      "name": "entitlements",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "entitlements",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "entitlements",
            "claim.name": "entitlements",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
