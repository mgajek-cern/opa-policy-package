{
  "realm": "rucio",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "sslRequired": "none",

  "roles": {
    "realm": [
      { "name": "offline_access", "description": "Role for creating offline tokens" }
    ]
  },

  "groups": [
    {
      "name": "rucio",
      "path": "/rucio",
      "subGroups": [
        { "name": "admins", "path": "/rucio/admins" },
        { "name": "users",  "path": "/rucio/users" }
      ]
    },
    {
      "name": "atlas",
      "path": "/atlas",
      "subGroups": [
        { "name": "production", "path": "/atlas/production" },
        { "name": "users",      "path": "/atlas/users" }
      ]
    }
  ],

  "users": [
    {
      "username": "alice",
      "id": "8b14e07a-3f52-4d6c-91ab-2e70d5c48f93",
      "email": "alice@example.org",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": [ "offline_access" ],
      "credentials": [{ "type": "password", "value": "alice123", "temporary": false }],
      "groups": ["/rucio/users", "/atlas/users"]
    },
    {
      "username": "adminuser",
      "id": "a37c2e91-6d84-4b0f-85e3-1c9a7f26db40",
      "email": "admin@example.org",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": [ "offline_access" ],
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "groups": ["/rucio/admins", "/atlas/production"]
    }
  ],

  "clients": [
    {
      "clientId": "rucio-oidc",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "rucio-oidc-secret",
      "publicClient": false,
      "redirectUris": ["http://rucio/*", "http://localhost/*"],
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["profile", "email", "wlcg"],
      "optionalClientScopes": ["offline_access", "aud:rucio"]
    }
  ],

  "clientScopes": [
    {
      "name": "wlcg",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "wlcg-version",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "wlcg\\.ver",
            "claim.value": "1.0",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "nbf-patch",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "nbf",
            "claim.value": "1700000000",
            "jsonType.label": "long",
            "access.token.claim": "true"
          }
        },
        {
          "name": "wlcg-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "wlcg\\.groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "aud:rucio",
      "description": "Adds rucio to the token's aud claim, so a directly-presented test token passes validate_jwt's expected_audience gate.",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-rucio",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "rucio",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
